{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./.tmp/progression-fixtures",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "strict": true,
    "types": [
      "node",
      "vite/client"
    ],
    "esModuleInterop": true
  },
  "include": [
    "tests/fixtures/progression/**/*.ts",
    "tests/helpers/progression/**/*.ts",
    "tests/migrations/loadFixture.ts",
    "tests/matrices/progressionFixtureMatrix.test.ts",
    "tests/matrices/progressionFixtureConsumerCoverage.test.ts",
    "tests/contracts/progressionFixtureScripts.test.ts",
    "src/systems/progression/**/*.ts",
    "scripts/listProgressionFixtures.ts",
    "scripts/validateProgressionFixtures.ts",
    "tests/contracts/progressionContract.test.ts",
    "tests/contracts/progressionDiagnostics.test.ts",
    "tests/contracts/progressionHarnessSmoke.test.ts",
    "tests/contracts/progressionSemanticValidator.test.ts",
    "tests/integration/cityUnlocks.test.ts",
    "tests/integration/gateContract.test.ts",
    "tests/integration/offlineContract.test.ts",
    "tests/integration/pathContract.test.ts",
    "tests/integration/prestigeReset.test.ts",
    "tests/contracts/liveRealmProjection.test.ts",
    "tests/integration/semesterSliceFreeze.test.ts"
  ]
}
