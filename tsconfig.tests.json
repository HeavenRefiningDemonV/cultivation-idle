{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./tmp-tests",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "strict": true,
    "types": [
      "node",
      "vite/client"
    ],
    "esModuleInterop": true
  },
  "include": [
    "tests/**/*.ts",
    "scripts/progressionContractReport.ts",
    "scripts/generateProgressionContractDoc.ts",
    "src/systems/progression/**/*.ts",
    "src/save/migrations/**/*.ts",
    "scripts/saveMigrationDryRun.ts",
    "src/systems/crafting/assistedPrompts.ts",
    "src/systems/crafting/craftingTypes.ts",
    "scripts/balanceRegressionReport.ts",
    "scripts/validateBalanceTelemetry.ts",
    "scripts/release/buildFreshRunAcceptanceReport.ts",
    "scripts/release/runMigrationMatrix.ts",
    "scripts/release/offlineRouteReport.ts",
    "scripts/release/reclaimRouteReport.ts",
    "scripts/release/buildRouteComparisonReport.ts",
    "scripts/release/captureBuildWarnings.ts",
    "scripts/release/runRuntimeDiagnostics.ts",
    "scripts/release/runReleaseGate.ts",
    "src/services/diagnostics/release/routeComparisonReport.ts",
    "src/services/diagnostics/release/buildAuditReport.ts",
    "src/services/diagnostics/release/runtimeDiagnosticsReport.ts",
    "src/services/diagnostics/buildContentLoadFailureDiagnostics.ts",
    "src/services/diagnostics/release/releaseGate*.ts",
    "src/services/diagnostics/release/knownIssuesLedger.ts"
  ]
}
