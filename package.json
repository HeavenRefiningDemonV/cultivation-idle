{
  "name": "cultivation-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ensure:vendor-links": "node scripts/linkVendorDeps.mjs",
    "build:progression-fixtures": "tsc --project tsconfig.progression-fixtures.json",
    "dev": "vite",
    "build": "npm run ensure:vendor-links && npm run typecheck && npm run check:icons && node ./node_modules/vite/bin/vite.js build",
    "check:icons": "node --experimental-strip-types scripts/checkNoEmojiIcons.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run ensure:vendor-links && tsc --project tsconfig.tests.json && npm run build:progression-fixtures && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --test tmp-tests/tests/**/*.js",
    "audio:audit": "node --experimental-strip-types scripts/audio/auditAudioAssets.ts",
    "validate:content": "NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --experimental-strip-types scripts/validateContent.ts",
    "preview": "vite preview",
    "test:contracts": "npm run ensure:vendor-links && tsc --project tsconfig.tests.json && npm run build:progression-fixtures && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --test tmp-tests/tests/contracts/**/*.js",
    "test:progression-packets-4.7-4.8": "npm run ensure:vendor-links && tsc --project tsconfig.tests.json && npm run build:progression-fixtures && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --test tmp-tests/tests/contracts/loadoutProgressionContract.test.js tmp-tests/tests/contracts/loadoutSnapshotContract.test.js tmp-tests/tests/contracts/loadoutUiHonestyGuard.test.js tmp-tests/tests/contracts/techniqueGradeCaps.test.js tmp-tests/tests/contracts/techniqueProgressionSnapshot.test.js tmp-tests/tests/contracts/techniqueProgressionDriftGuard.test.js tmp-tests/tests/contracts/masteryContract.test.js tmp-tests/tests/integration/loadoutProgressionStoreBridge.test.js tmp-tests/tests/integration/techniqueProgressionStoreBridge.test.js",
    "progression:report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/progressionContractReport.js",
    "validate:progression-contract": "npm run test:contracts && npm run progression:report",
    "docs:progression-contract": "tsc --project tsconfig.tests.json && node tmp-tests/scripts/generateProgressionContractDoc.js",
    "migration:dry-run": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/saveMigrationDryRun.js",
    "migration:report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/saveMigrationDryRun.js --json",
    "progression:fixtures": "npm run build:progression-fixtures && node tmp-progression-fixtures/scripts/listProgressionFixtures.js",
    "validate:progression-fixtures": "npm run build:progression-fixtures && node tmp-progression-fixtures/scripts/validateProgressionFixtures.js",
    "progression:matrix": "npm run build:progression-fixtures && node tmp-progression-fixtures/scripts/validateProgressionFixtures.js --matrix",
    "test:progression-fixtures": "npm run build:progression-fixtures && node --test tmp-progression-fixtures/tests/contracts/*.js tmp-progression-fixtures/tests/integration/*.js tmp-progression-fixtures/tests/matrices/*.js",
    "telemetry:export": "node --experimental-strip-types scripts/exportBalanceTelemetry.ts",
    "telemetry:summary": "node --experimental-strip-types scripts/summarizeBalanceTelemetry.ts",
    "test:balance-regression": "npm run ensure:vendor-links && tsc --project tsconfig.tests.json && npm run build:progression-fixtures && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --test tmp-tests/tests/integration/phaseTimingEnvelope.test.js tmp-tests/tests/integration/cityPhaseDurationRegression.test.js tmp-tests/tests/integration/activityThroughputRegression.test.js tmp-tests/tests/integration/prepVsBypassEconomy.test.js tmp-tests/tests/integration/bountyMeritFailSafePacing.test.js tmp-tests/tests/integration/antiStallWindows.test.js tmp-tests/tests/integration/gateAttemptWinrateEnvelope.test.js tmp-tests/tests/integration/offlineContributionBounds.test.js tmp-tests/tests/integration/prestigeAPHourRegression.test.js tmp-tests/tests/integration/reclaimSpeedTargets.test.js",
    "balance:report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/balanceRegressionReport.js",
    "balance:report:json": "npm run balance:report -- --json",
    "release:fresh-run-report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/buildFreshRunAcceptanceReport.js",
    "release:fresh-run-report:json": "npm run release:fresh-run-report -- --json",
    "release:migration-matrix": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/runMigrationMatrix.js",
    "release:migration-matrix:json": "npm run release:migration-matrix -- --json",
    "release:offline-route-report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/offlineRouteReport.js",
    "release:reclaim-route-report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/reclaimRouteReport.js",
    "release:route-report": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/buildRouteComparisonReport.js",
    "release:route-report:json": "npm run release:route-report -- --json",
    "release:build-audit": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/captureBuildWarnings.js --write-doc",
    "release:build-audit:json": "npm run release:build-audit -- --json",
    "release:runtime-diagnostics": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/release/runRuntimeDiagnostics.js",
    "release:runtime-diagnostics:json": "npm run release:runtime-diagnostics -- --json",
    "release:vocab-audit": "NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --experimental-strip-types scripts/release/auditVocabulary.ts",
    "release:vocab-audit:json": "npm run release:vocab-audit -- --json",
    "release:gate": "NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --experimental-strip-types scripts/release/runReleaseGate.ts --fail-on-blockers",
    "release:gate:json": "npm run release:gate -- --json",
    "release:handoff": "NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node --experimental-strip-types scripts/release/buildReleaseHandoffBundle.ts",
    "validate:balance-regression": "npm run test:balance-regression && npm run balance:report -- --fail-on-drift",
    "validate:balance-telemetry": "tsc --project tsconfig.tests.json && NODE_OPTIONS='--loader=./scripts/relativeJsLoader.mjs' node tmp-tests/scripts/validateBalanceTelemetry.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "classnames": "file:vendor/classnames",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.23.24",
    "immer": "^10.2.0",
    "lucide-react": "^0.553.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-spring": "^10.0.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.8",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "sass": "file:vendor/sass-stub",
    "sass-embedded": "file:vendor/sass-embedded",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
