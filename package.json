{
  "name": "cultivation-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check:icons && vite build",
    "check:icons": "node --experimental-strip-types scripts/checkNoEmojiIcons.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.tests.json && node --test tmp-tests/tests/**/*.js",
    "audio:audit": "node --experimental-strip-types scripts/audio/auditAudioAssets.ts",
    "validate:content": "node --experimental-strip-types scripts/validateContent.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.23.24",
    "classnames": "file:vendor/classnames",
    "immer": "^10.2.0",
    "lucide-react": "^0.553.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-spring": "^10.0.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "sass": "file:vendor/sass-stub",
    "sass-embedded": "file:vendor/sass-embedded",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
